package repository

import (
	"context"
	"database/sql"
	"errors"
	"fmt"

	"github.com/jmoiron/sqlx"

	"[[ .ModulePath ]]/internal/model"
)

// UserRepository handles all database operations for the users table.
// Uses sqlx for named queries and struct scanning — no ORM magic.
// Accepts *sqlx.DB directly (database.DB embeds it).
type UserRepository struct {
	db *sqlx.DB
}

func NewUserRepository(db *sqlx.DB) *UserRepository {
	return &UserRepository{db: db}
}

// Create inserts a new user and returns the created row (with generated ID + timestamps).
// RETURNING * fetches the full row in a single round-trip.
func (r *UserRepository) Create(ctx context.Context, email, hashedPassword string) (*model.User, error) {
	const q = `
		INSERT INTO users (email, password)
		VALUES ($1, $2)
		RETURNING *`

	var user model.User
	if err := r.db.GetContext(ctx, &user, q, email, hashedPassword); err != nil {
		return nil, fmt.Errorf("creating user: %w", err)
	}
	return &user, nil
}

// GetByEmail looks up a user by email address.
// Returns sql.ErrNoRows if not found — callers should check for this specifically.
func (r *UserRepository) GetByEmail(ctx context.Context, email string) (*model.User, error) {
	const q = `SELECT * FROM users WHERE email = $1 LIMIT 1`

	var user model.User
	if err := r.db.GetContext(ctx, &user, q, email); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, sql.ErrNoRows
		}
		return nil, fmt.Errorf("getting user by email: %w", err)
	}
	return &user, nil
}

// GetByID looks up a user by UUID primary key.
// Returns sql.ErrNoRows if not found.
func (r *UserRepository) GetByID(ctx context.Context, id string) (*model.User, error) {
	const q = `SELECT * FROM users WHERE id = $1 LIMIT 1`

	var user model.User
	if err := r.db.GetContext(ctx, &user, q, id); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, sql.ErrNoRows
		}
		return nil, fmt.Errorf("getting user by id: %w", err)
	}
	return &user, nil
}
