# Server
PORT=8080

# PostgreSQL — format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/[[ .DBName ]]?sslmode=disable
[[ if .WithAuth ]]
# JWT — use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production
[[ end -]]
