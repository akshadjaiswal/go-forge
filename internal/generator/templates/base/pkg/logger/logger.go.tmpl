package logger

import (
	"log/slog"
	"os"
)

// New returns a structured JSON logger writing to stdout.
// In production, ship logs to your aggregator (Datadog, Loki, CloudWatch, etc.)
// as newline-delimited JSON — this format is natively supported by all of them.
func New() *slog.Logger {
	return slog.New(slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{
		Level: slog.LevelInfo,
	}))
}
